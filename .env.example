# Copy to .env and fill in. See internal/platform/config/config.go for
# how each of these is read; anything not listed there has no effect.

# --- Required: Load() fails to start without these ---

PORT=8080

# ed25519 seed for signing access/refresh JWTs. Generate a real one with:
#   go run ./cmd/genkey
JWT_ED25519_SEED_BASE64=

# --- Postgres ---

BLUEPRINT_DB_HOST=127.0.0.1
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_DATABASE=app
BLUEPRINT_DB_USERNAME=app
BLUEPRINT_DB_PASSWORD=app
BLUEPRINT_DB_SCHEMA=public

# --- Redis (presence, caching). Default if unset: redis://127.0.0.1:6379 ---

REDIS_URL=redis://127.0.0.1:6379

# --- NATS / JetStream (events). Default if unset: nats://127.0.0.1:4222 ---

NATS_URL=nats://127.0.0.1:4222

# --- MinIO (avatar storage) ---

# Default if unset: 127.0.0.1:9000
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Default if unset: avatars
MINIO_BUCKET=avatars
MINIO_USE_SSL=false

# --- Web push (optional; leave blank to disable push notifications) ---

# Generate a VAPID key pair: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:you@example.com
# Firebase Cloud Messaging project (Android push). Leave blank to disable.
PUSH_FCM_PROJECT_ID=
# Full FCM service-account JSON, as a single-line string.
PUSH_FCM_CREDENTIALS_JSON=

# --- CORS. Default if unset: http://localhost:5173 ---

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8082

# --- media-service (calls) ---

MEDIA_NODE_ID=media-1
MEDIA_GRPC_ADDR=127.0.0.1:9090
MEDIA_WS_ADDR=localhost:8082
# Shared bearer token between api and media's gRPC control plane.
MEDIA_RPC_TOKEN=devtoken
# Default if unset: 50
MEDIA_ROOM_CAPACITY=50
# Default if unset: 16
MEDIA_MAX_ROOM_PEERS=16
# Go duration string. Default if unset: 60s
MEDIA_JOIN_TICKET_TTL=60s

# --- TURN/STUN (call relay) ---

TURN_URL=turn:127.0.0.1:3478
TURN_TLS_URL=
# Must equal coturn's own static-auth-secret (see deploy/kubernetes/base/coturn.yaml).
TURN_SECRET=devsecret
# Go duration string. Default if unset: 1h
TURN_CREDENTIAL_TTL=1h
# Comma-separated. Default if unset: stun:stun.l.google.com:19302
STUN_URLS=stun:127.0.0.1:3478

# --- Swagger UI. Default if unset: false ---

SWAGGER_ENABLED=false
